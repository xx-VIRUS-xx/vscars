* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --dark-bg: #0a0014;
    --darker-bg: #050008;
    --card-bg: #1a0033;
    --card-dark: #0f0020;
    --accent-cyan: #00ffff;
    --accent-purple: #ff00ff;
    --accent-pink: #ff0099;
    --accent-orange: #ff6600;
    --text-primary: #00ffff;
    --text-secondary: #ff00ff;
    --text-muted: #00cccc;
    --border-color: rgba(0, 255, 255, 0.3);
    --success: #00ff00;
    --error: #ff0066;
    --warning: #ffff00;
    --neon-glow: 0 0 20px rgba(0, 255, 255, 0.6);
    --neon-glow-pink: 0 0 20px rgba(255, 0, 153, 0.6);
    --neon-glow-purple: 0 0 20px rgba(255, 0, 255, 0.6);
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-20px); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes slideInRight {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes glow {
    0%, 100% { box-shadow: 0 0 20px rgba(0, 255, 255, 0.6), 0 0 40px rgba(255, 0, 255, 0.3); }
    50% { box-shadow: 0 0 40px rgba(0, 255, 255, 0.8), 0 0 60px rgba(255, 0, 255, 0.5); }
}

@keyframes neonPulse {
    0%, 100% { text-shadow: 0 0 10px rgba(0, 255, 255, 0.5), 0 0 20px rgba(255, 0, 255, 0.3); }
    50% { text-shadow: 0 0 20px rgba(0, 255, 255, 0.8), 0 0 40px rgba(255, 0, 255, 0.6); }
}

@keyframes cyberGlitch {
    0% { text-shadow: -2px 0 #ff00ff, 2px 0 #00ffff; }
    50% { text-shadow: 2px 0 #ff00ff, -2px 0 #00ffff; }
    100% { text-shadow: -2px 0 #ff00ff, 2px 0 #00ffff; }
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes shimmer {
    0% { background-position: -1000px 0; }
    100% { background-position: 1000px 0; }
}

body {
    font-family: 'Courier New', monospace;
    background: linear-gradient(135deg, #0a0014 0%, #1a0033 50%, #0a0014 100%);
    min-height: 100vh;
    color: var(--text-primary);
    animation: fadeIn 0.6s ease-out;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
}

.container {
    max-width: 1400px;
    margin: 0 auto;
    min-height: 100vh;
}

/* ==================== TOAST NOTIFICATIONS ==================== */

.toast-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.toast {
    padding: 16px 20px;
    border-radius: 12px;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-color);
    animation: slideInRight 0.4s ease-out;
    min-width: 300px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.toast.success {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.3);
}

.toast.error {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.3);
}

.toast.warning {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    border-color: rgba(245, 158, 11, 0.3);
}

.toast.info {
    background: rgba(0, 217, 255, 0.15);
    color: var(--accent-cyan);
    border-color: var(--border-color);
}

.toast-icon {
    font-size: 1.3em;
    font-weight: bold;
}

/* ==================== LOADING OVERLAY ==================== */

.loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 14, 39, 0.9);
    backdrop-filter: blur(5px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 2000;
    animation: fadeIn 0.3s ease-out;
}

.spinner {
    width: 50px;
    height: 50px;
    border: 3px solid rgba(0, 217, 255, 0.2);
    border-top: 3px solid var(--accent-cyan);
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 20px;
}

#loading-text {
    color: var(--accent-cyan);
    font-size: 1.1em;
    font-weight: 500;
}

/* ==================== AUTH VIEW ==================== */

.auth-view {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: fadeIn 0.6s ease-out;
}

.auth-box {
    background: rgba(26, 40, 71, 0.8);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(0, 217, 255, 0.1);
    padding: 50px;
    width: 100%;
    max-width: 450px;
    animation: slideInLeft 0.6s ease-out;
}

.auth-header {
    text-align: center;
    margin-bottom: 40px;
}

.auth-box h1 {
    font-size: 2.8em;
    background: linear-gradient(135deg, #00ffff 0%, #ff00ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
    margin-bottom: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
    animation: neonPulse 3s ease-in-out infinite;
}

.subtitle {
    color: var(--text-muted);
    font-size: 0.95em;
    font-weight: 500;
}

.tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 35px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0;
}

.tab-btn {
    flex: 1;
    padding: 14px 16px;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.9em;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    position: relative;
    overflow: hidden;
    z-index: 10;
}

.tab-btn::before {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-cyan), var(--accent-purple));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-btn.active::before {
    transform: scaleX(1);
}

.tab-btn:hover {
    color: var(--accent-cyan);
}

.tab-btn.active {
    color: var(--accent-cyan);
}

.tab-icon {
    font-size: 1.2em;
}

.tab-content {
    display: none;
    animation: fadeIn 0.3s ease-out;
}

.tab-content.active {
    display: block;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.9em;
    letter-spacing: 0.5px;
}

.auth-box input {
    width: 100%;
    padding: 14px 16px;
    border: 2px solid var(--accent-cyan);
    background: rgba(10, 0, 20, 0.8);
    border-radius: 8px;
    font-size: 1em;
    color: var(--text-primary);
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
    box-shadow: inset 0 0 10px rgba(0, 255, 255, 0.1), 0 0 15px rgba(0, 255, 255, 0.2);
    font-family: 'Courier New', monospace;
}

.auth-box input::placeholder {
    color: var(--text-muted);
}

.auth-box input:focus {
    outline: none;
    border-color: var(--accent-pink);
    background: rgba(10, 0, 20, 0.95);
    box-shadow: inset 0 0 20px rgba(255, 0, 153, 0.1), 0 0 20px rgba(255, 0, 153, 0.4), 0 0 40px rgba(0, 255, 255, 0.2);
}

.auth-box button {
    width: 100%;
    padding: 14px 16px;
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-purple) 100%);
    color: var(--darker-bg);
    border: none;
    border-radius: 10px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 1em;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 217, 255, 0.2);
}

.auth-box button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.1);
    transition: left 0.3s ease;
}

.auth-box button:hover::before {
    left: 100%;
}

.auth-box button:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(0, 217, 255, 0.3);
}

.auth-box button:active {
    transform: translateY(0);
}

.error-msg {
    color: var(--error);
    margin-top: 12px;
    font-size: 0.9em;
    text-align: center;
    animation: fadeIn 0.3s ease-out;
}

.info-text {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    padding: 12px 14px;
    border-radius: 8px;
    margin-bottom: 16px;
    font-size: 0.85em;
    border-left: 3px solid #10b981;
}

.qr-display-box {
    text-align: center;
    padding: 24px;
    background: rgba(15, 23, 42, 0.5);
    border-radius: 14px;
    margin-top: 20px;
    border: 1px solid var(--border-color);
    animation: slideInRight 0.4s ease-out;
    backdrop-filter: blur(10px);
}

.qr-image-wrapper {
    margin: 16px 0;
}

.qr-code-img {
    max-width: 200px;
    width: 100%;
    padding: 10px;
    background: white;
    border-radius: 12px;
    animation: float 3s ease-in-out infinite;
}

.qr-instruction {
    color: var(--text-secondary);
    margin-top: 15px;
    font-weight: 500;
}

.qr-request-id {
    margin-top: 10px;
    color: var(--accent-cyan);
    font-size: 0.85em;
    word-break: break-all;
    font-family: monospace;
}

/* ==================== MAIN VIEW ==================== */

.main-view {
    display: flex;
    flex-direction: column;
    animation: fadeIn 0.6s ease-out;
}

.header {
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-color);
    padding: 0;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2), inset 0 1px 1px rgba(0, 217, 255, 0.05);
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    gap: 20px;
}

.header-left {
    flex: 0 0 auto;
}

.header-title {
    background: linear-gradient(90deg, var(--accent-cyan) 0%, var(--accent-purple) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: 1.65em;
    font-weight: 800;
    margin: 0;
    letter-spacing: -1px;
}

.header-center {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex: 1;
}

.status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9em;
    color: var(--text-muted);
    transition: all 0.3s ease;
    padding: 6px 12px;
    border-radius: 8px;
    background: rgba(0, 217, 255, 0.05);
    border: 1px solid rgba(0, 217, 255, 0.1);
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    animation: glow 2s infinite;
}

.status-indicator.active {
    color: var(--accent-cyan);
}

.ngrok-indicator {
    padding: 8px 14px;
    background: linear-gradient(135deg, rgba(0, 217, 255, 0.1), rgba(168, 85, 247, 0.1));
    color: var(--accent-cyan);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 0.85em;
    font-weight: 600;
    animation: slideInRight 0.4s ease-out;
}

.header-right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 0 0 auto;
}

.user-info {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    background: rgba(0, 217, 255, 0.05);
    border: 1px solid var(--border-color);
    border-radius: 10px;
}

.user-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.user-name {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 0.95em;
}

.badge {
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-purple) 100%);
    color: var(--darker-bg);
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 0.7em;
    font-weight: 800;
    display: inline-block;
}

.badge.superuser {
    background: linear-gradient(135deg, var(--accent-pink) 0%, var(--accent-purple) 100%);
}

.btn-logout {
    padding: 10px 18px;
    background: linear-gradient(135deg, var(--error) 0%, #c6162d 100%);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9em;
    box-shadow: 0 8px 20px rgba(239, 68, 68, 0.2);
}

.btn-logout:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(239, 68, 68, 0.4);
}

/* ==================== MAIN LAYOUT ==================== */

.main-content {
    display: flex;
    flex: 1;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    gap: 0;
}

.sidebar {
    width: 220px;
    background: rgba(10, 14, 27, 0.6);
    border-right: 1px solid var(--border-color);
    padding: 20px;
    overflow-y: auto;
    backdrop-filter: blur(10px);
}

.sidebar::-webkit-scrollbar {
    width: 6px;
}

.sidebar::-webkit-scrollbar-track {
    background: transparent;
}

.sidebar::-webkit-scrollbar-thumb {
    background: rgba(0, 217, 255, 0.2);
    border-radius: 3px;
}

.sidebar::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 217, 255, 0.3);
}

.nav-menu {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.nav-item {
    padding: 12px 14px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    cursor: pointer;
    text-align: left;
    font-weight: 600;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    overflow: hidden;
}

.nav-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(180deg, var(--accent-cyan), var(--accent-purple));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.3s ease;
}

.nav-item:hover {
    background: rgba(0, 217, 255, 0.05);
    color: var(--accent-cyan);
    border-color: var(--border-color);
    transform: translateX(4px);
}

.nav-item.active {
    background: linear-gradient(135deg, rgba(0, 217, 255, 0.15) 0%, rgba(168, 85, 247, 0.15) 100%);
    color: var(--accent-cyan);
    border-color: var(--border-color);
}

.nav-item.active::before {
    transform: scaleY(1);
}

.nav-icon {
    font-size: 1.3em;
    display: inline-block;
}

.nav-label {
    display: inline-block;
}

.content {
    flex: 1;
    padding: 30px;
    overflow-y: auto;
}

.content::-webkit-scrollbar {
    width: 8px;
}

.content::-webkit-scrollbar-track {
    background: transparent;
}

.content::-webkit-scrollbar-thumb {
    background: rgba(0, 217, 255, 0.2);
    border-radius: 4px;
}

.content::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 217, 255, 0.3);
}

.view {
    display: none;
    animation: fadeIn 0.4s ease-out;
}

.view.active {
    display: block;
}

.view-title {
    color: var(--text-primary);
    margin-bottom: 25px;
    font-size: 2.2em;
    font-weight: 800;
    letter-spacing: -1px;
}

.skeleton {
    height: 60px;
    background: linear-gradient(90deg, rgba(0, 217, 255, 0.1) 25%, rgba(0, 217, 255, 0.2) 50%, rgba(0, 217, 255, 0.1) 75%);
    background-size: 200% 100%;
    animation: shimmer 2s infinite;
    border-radius: 10px;
    margin-bottom: 10px;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
}

.card {
    background: rgba(26, 40, 71, 0.6);
    backdrop-filter: blur(15px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 28px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    animation: fadeIn 0.5s ease-out;
    position: relative;
    overflow: hidden;
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ff00ff, transparent);
    opacity: 0.5;
    transition: opacity 0.3s ease;
}

.card:hover {
    box-shadow: 0 0 40px rgba(0, 255, 255, 0.5), 0 0 20px rgba(255, 0 , 255, 0.3), inset 0 0 30px rgba(0, 255, 255, 0.1);
    border-color: #ff00ff;
    transform: translateY(-5px);
}

.card:hover::before {
    opacity: 1;
}

.card:hover {
    transform: translateY(-8px);
    border-color: var(--border-color);
    box-shadow: 0 20px 60px rgba(0, 217, 255, 0.1);
}

.card-primary {
    border-top: 2px solid var(--accent-cyan);
}

.card-permissions {
    border-top: 2px solid var(--success);
}

.card-access {
    border-top: 2px solid var(--accent-purple);
}

.card-admin {
    border-top: 2px solid var(--accent-pink);
}

.card-header {
    margin-bottom: 20px;
}

.card h3 {
    color: var(--text-primary);
    margin: 0;
    font-size: 1.2em;
    font-weight: 700;
    letter-spacing: -0.5px;
}

.quick-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.action-btn {
    padding: 16px 18px;
    background: linear-gradient(135deg, rgba(0, 217, 255, 0.1) 0%, rgba(168, 85, 247, 0.1) 100%);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    position: relative;
    overflow: hidden;
}

.action-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transition: left 0.5s ease;
}

.action-btn:hover::before {
    left: 100%;
}

.action-btn:hover {
    transform: translateY(-3px);
    border-color: var(--accent-cyan);
    box-shadow: 0 10px 30px rgba(0, 217, 255, 0.2);
}

.action-open {
    border-color: rgba(0, 217, 255, 0.2);
}

.action-run {
    border-color: rgba(16, 185, 129, 0.2);
}

.action-chat {
    border-color: rgba(168, 85, 247, 0.2);
}

.action-icon {
    font-size: 1.4em;
}

.action-label {
    display: inline-block;
}

.permissions-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.permission-item {
    padding: 12px 14px;
    background: rgba(0, 217, 255, 0.05);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 0.95em;
    display: flex;
    align-items: center;
    gap: 10px;
    border-left: 3px solid transparent;
    transition: all 0.3s ease;
}

.permission-item.granted {
    color: var(--success);
    background: rgba(16, 185, 129, 0.05);
    border-left-color: var(--success);
    border-color: rgba(16, 185, 129, 0.2);
}

.permission-item.denied {
    color: var(--error);
    background: rgba(239, 68, 68, 0.05);
    border-left-color: var(--error);
    border-color: rgba(239, 68, 68, 0.2);
}

.ngrok-box {
    padding: 20px;
    background: rgba(168, 85, 247, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.2);
    border-radius: 12px;
    animation: slideInRight 0.4s ease-out;
    backdrop-filter: blur(10px);
}

.ngrok-label {
    color: var(--text-secondary);
    font-weight: 700;
    font-size: 0.95em;
    margin-bottom: 10px;
    display: block;
    letter-spacing: 0.5px;
}

.url-box {
    display: flex;
    gap: 10px;
    margin: 12px 0;
}

.url-input {
    flex: 1;
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    background: rgba(15, 23, 42, 0.8);
    border-radius: 8px;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
    color: var(--accent-cyan);
    word-break: break-all;
    backdrop-filter: blur(10px);
}

.btn-copy {
    padding: 12px 14px;
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-purple) 100%);
    color: var(--darker-bg);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    font-size: 1.2em;
    box-shadow: 0 8px 20px rgba(0, 217, 255, 0.2);
}

.btn-copy:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 30px rgba(0, 217, 255, 0.3);
}

.ngrok-hint {
    font-size: 0.85em;
    color: var(--text-muted);
    margin: 10px 0 0 0;
}

.placeholder {
    text-align: center;
    color: var(--text-muted);
    padding: 40px;
    font-size: 1em;
}

.tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
}

.tool-card {
    background: rgba(26, 40, 71, 0.6);
    backdrop-filter: blur(15px);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 20px;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    animation: fadeIn 0.5s ease-out;
    position: relative;
    overflow: hidden;
}

.tool-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 217, 255, 0.1), rgba(168, 85, 247, 0.1));
    opacity: 0;
    transition: opacity 0.3s ease;
}

.tool-card:hover::before {
    opacity: 1;
}

.tool-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent-cyan);
    box-shadow: 0 15px 40px rgba(0, 217, 255, 0.15);
}

.tool-card h3 {
    color: var(--accent-cyan);
    margin-bottom: 10px;
    font-size: 1.1em;
    font-weight: 700;
    position: relative;
    z-index: 1;
}

.tool-card p {
    color: var(--text-muted);
    font-size: 0.9em;
    margin-bottom: 12px;
    line-height: 1.5;
    position: relative;
    z-index: 1;
}

.tool-permission {
    display: inline-block;
    padding: 6px 10px;
    background: rgba(0, 217, 255, 0.1);
    color: var(--accent-cyan);
    border-radius: 6px;
    font-size: 0.75em;
    font-weight: 700;
    border: 1px solid var(--border-color);
    position: relative;
    z-index: 1;
}

.tool-permission.denied {
    background: rgba(239, 68, 68, 0.1);
    color: var(--error);
    border-color: rgba(239, 68, 68, 0.2);
}

.file-browser {
    background: rgba(26, 40, 71, 0.6);
    backdrop-filter: blur(15px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
}

.file-path-section {
    display: flex;
    gap: 10px;
    margin-bottom: 25px;
}

.file-input {
    flex: 1;
    padding: 12px 16px;
    border: 1px solid var(--border-color);
    background: rgba(15, 23, 42, 0.8);
    border-radius: 10px;
    font-size: 1em;
    color: var(--text-primary);
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
}

.file-input::placeholder {
    color: var(--text-muted);
}

.file-input:focus {
    outline: none;
    border-color: var(--accent-cyan);
    background: rgba(15, 23, 42);
    box-shadow: 0 0 0 3px rgba(0, 217, 255, 0.1);
}

.btn-browse {
    padding: 12px 20px;
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-purple) 100%);
    color: var(--darker-bg);
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 8px 20px rgba(0, 217, 255, 0.2);
}

.btn-browse:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 217, 255, 0.3);
}

.files-list {
    display: grid;
    gap: 10px;
}

.file-item {
    padding: 14px 16px;
    background: rgba(0, 217, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 12px;
    border-left: 3px solid transparent;
}

.file-item:hover {
    background: rgba(0, 217, 255, 0.08);
    border-left-color: var(--accent-cyan);
    transform: translateX(4px);
    box-shadow: 0 4px 12px rgba(0, 217, 255, 0.1);
}

.file-icon {
    font-size: 1.4em;
    min-width: 30px;
}

/* ==================== ACTIVITY LOG ==================== */
.activity-container {
    background: rgba(26, 40, 71, 0.6);
    backdrop-filter: blur(15px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
}

.activity-controls {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.activity-log-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 600px;
    overflow-y: auto;
}

.activity-item {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 16px;
    transition: all 0.3s ease;
    border-left: 4px solid var(--accent-cyan);
}

.activity-item.error {
    border-left-color: #ef4444;
}

.activity-item:hover {
    background: rgba(15, 23, 42, 0.9);
    box-shadow: 0 4px 12px rgba(0, 217, 255, 0.1);
    transform: translateX(4px);
}

.activity-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    font-size: 0.95em;
}

.activity-status {
    font-size: 1.2em;
    min-width: 24px;
}

.activity-tool {
    font-weight: 600;
    color: var(--accent-cyan);
    min-width: 120px;
}

.activity-time {
    color: var(--text-muted);
    margin-left: auto;
    font-size: 0.9em;
}

.activity-body {
    margin-left: 36px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.activity-action {
    color: var(--text-primary);
    font-weight: 500;
    margin: 0;
}

.activity-result {
    color: var(--text-muted);
    font-size: 0.9em;
    margin: 0;
    word-break: break-word;
    max-height: 120px;
    overflow-y: auto;
    padding-right: 8px;
}

.activity-device {
    color: var(--accent-purple);
    font-size: 0.9em;
    margin: 0;
}

/* ==================== CONVERSATIONS ==================== */
.conversations-container {
    background: rgba(26, 40, 71, 0.6);
    backdrop-filter: blur(15px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
}

.conversations-controls {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.conversations-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-height: 700px;
    overflow-y: auto;
}

.conversation-item {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    transition: all 0.3s ease;
    border-left: 4px solid var(--accent-purple);
}

.conversation-item.error {
    border-left-color: #ef4444;
}

.conversation-item:hover {
    background: rgba(15, 23, 42, 0.9);
    box-shadow: 0 4px 12px rgba(168, 85, 247, 0.2);
    transform: translateX(4px);
}

.conversation-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    font-size: 0.9em;
}

.conversation-status {
    font-size: 1.2em;
    min-width: 24px;
}

.conversation-time {
    color: var(--text-muted);
    margin-left: auto;
    font-size: 0.85em;
}

.conversation-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.conversation-query {
    padding: 12px;
    background: rgba(0, 217, 255, 0.05);
    border: 1px solid rgba(0, 217, 255, 0.1);
    border-radius: 8px;
}

.query-label {
    color: var(--accent-cyan);
    font-weight: 600;
    margin: 0 0 8px 0;
    font-size: 0.9em;
}

.query-text {
    color: var(--text-primary);
    margin: 0;
    word-wrap: break-word;
    font-weight: 500;
}

.conversation-response {
    padding: 12px;
    background: rgba(168, 85, 247, 0.05);
    border: 1px solid rgba(168, 85, 247, 0.1);
    border-radius: 8px;
}

.response-label {
    color: var(--accent-purple);
    font-weight: 600;
    margin: 0 0 8px 0;
    font-size: 0.9em;
}

.response-text {
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
    max-height: 150px;
    overflow-y: auto;
    font-size: 0.9em;
}

/* ==================== EXECUTION LOGS ==================== */
.execution-logs-container {
    background: rgba(26, 40, 71, 0.6);
    backdrop-filter: blur(15px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
}

.execution-logs-controls {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.execution-logs-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-height: 700px;
    overflow-y: auto;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: rgba(15, 23, 42, 0.4);
}

.logs-header {
    padding: 16px;
    border-bottom: 1px solid var(--border-color);
    background: rgba(0, 217, 255, 0.05);
}

.logs-info {
    color: var(--accent-cyan);
    font-weight: 600;
    margin: 0 0 8px 0;
    font-size: 0.95em;
}

.logs-path {
    color: var(--text-muted);
    font-size: 0.9em;
    margin: 0;
    word-break: break-all;
}

.logs-content {
    padding: 16px;
    background: rgba(15, 23, 42, 0.8);
    border-radius: 0 0 12px 12px;
    overflow-x: auto;
}

.logs-text {
    margin: 0;
    padding: 0;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    line-height: 1.6;
    color: var(--accent-cyan);
    white-space: pre-wrap;
    word-wrap: break-word;
    background: transparent;
}

.logs-text::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

.logs-text::-webkit-scrollbar-track {
    background: rgba(0, 217, 255, 0.05);
}

.logs-text::-webkit-scrollbar-thumb {
    background: rgba(0, 217, 255, 0.3);
    border-radius: 4px;
}

.logs-text::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 217, 255, 0.5);
}

.admin-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
}

.requests-list, .users-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.request-item, .user-item {
    padding: 18px;
    background: rgba(26, 40, 71, 0.6);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    border-left: 4px solid var(--border-color);
    transition: all 0.3s ease;
    animation: slideInLeft 0.4s ease-out;
    border: 1px solid var(--border-color);
}

.request-item:hover, .user-item:hover {
    box-shadow: 0 8px 20px rgba(0, 217, 255, 0.1);
    transform: translateX(4px);
}

.request-item.pending {
    border-left-color: var(--warning);
    background: rgba(245, 158, 11, 0.05);
}

.request-item.approved {
    border-left-color: var(--success);
    background: rgba(16, 185, 129, 0.05);
}

.request-item.rejected {
    border-left-color: var(--error);
    background: rgba(239, 68, 68, 0.05);
}

.request-actions {
    display: flex;
    gap: 10px;
    margin-top: 14px;
}

.btn-approve, .btn-reject, .btn-secondary, .btn-primary, .btn-danger {
    flex: 1;
    padding: 10px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
    transition: all 0.3s ease;
    font-size: 0.9em;
}

.btn-approve {
    background: linear-gradient(135deg, var(--success) 0%, #059669 100%);
    color: white;
    box-shadow: 0 8px 16px rgba(16, 185, 129, 0.2);
}

.btn-approve:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(16, 185, 129, 0.3);
}

.btn-reject, .btn-danger {
    background: linear-gradient(135deg, var(--error) 0%, #dc2626 100%);
    color: white;
    box-shadow: 0 8px 16px rgba(239, 68, 68, 0.2);
}

.btn-reject:hover, .btn-danger:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(239, 68, 68, 0.3);
}

.btn-secondary {
    background: rgba(0, 217, 255, 0.1);
    color: var(--accent-cyan);
    border: 1px solid var(--border-color);
}

.btn-secondary:hover {
    background: rgba(0, 217, 255, 0.2);
    border-color: var(--accent-cyan);
}

.btn-primary {
    background: linear-gradient(135deg, #00ffff 0%, #ff00ff 100%);
    color: #0a0014;
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.6), 0 0 40px rgba(255, 0, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: 'Courier New', monospace;
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 30px rgba(0, 255, 255, 0.8), 0 0 60px rgba(255, 0, 255, 0.6);
    animation: neonPulse 0.6s ease-in-out;
}

.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 14, 39, 0.8);
    backdrop-filter: blur(5px);
    animation: fadeIn 0.3s ease-out;
}

.modal.open {
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-content {
    background: linear-gradient(135deg, rgba(10, 0, 20, 0.95) 0%, rgba(26, 0, 52, 0.95) 100%);
    backdrop-filter: blur(20px);
    padding: 30px;
    border-radius: 12px;
    max-width: 650px;
    width: 90%;
    box-shadow: 0 0 60px rgba(0, 255, 255, 0.4), 0 0 30px rgba(255, 0, 255, 0.2), inset 0 1px 1px rgba(0, 255, 255, 0.2);
    border: 2px solid var(--accent-cyan);
    animation: slideInLeft 0.4s ease-out;
}

.close {
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
    color: var(--text-muted);
    background: none;
    border: none;
    padding: 0;
    transition: color 0.3s ease;
    line-height: 1;
}

.close:hover {
    color: var(--accent-cyan);
}

.modal-title {
    color: var(--text-primary);
    margin-bottom: 20px;
    margin-top: 10px;
    font-size: 1.4em;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    animation: neonPulse 2s ease-in-out infinite;
}

.tool-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.tool-inputs {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.tool-inputs label {
    color: var(--text-secondary);
    font-weight: 700;
    font-size: 0.95em;
    margin-bottom: 6px;
    display: block;
    letter-spacing: 0.5px;
}

.tool-inputs input, .tool-inputs textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    background: rgba(15, 23, 42, 0.6);
    border-radius: 10px;
    font-size: 1em;
    color: var(--text-primary);
    transition: all 0.3s ease;
    font-family: 'Courier New', monospace;
    backdrop-filter: blur(10px);
}

.tool-inputs input::placeholder, .tool-inputs textarea::placeholder {
    color: var(--text-muted);
}

.tool-inputs input:focus, .tool-inputs textarea:focus {
    outline: none;
    border-color: var(--accent-cyan);
    background: rgba(15, 23, 42, 0.8);
    box-shadow: 0 0 0 3px rgba(0, 217, 255, 0.1);
}

.tool-inputs textarea {
    resize: vertical;
    min-height: 120px;
}

.modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 24px;
}

.tool-result {
    margin-top: 24px;
    animation: fadeIn 0.3s ease-out;
}

.tool-result {
    background: rgba(26, 40, 71, 0.7);
    border: 2px solid var(--accent-cyan);
    border-radius: 16px;
    padding: 20px;
    margin-top: 20px;
    backdrop-filter: blur(20px);
    box-shadow: 0 8px 32px rgba(0, 217, 255, 0.15);
    animation: slideIn 0.3s ease-out;
}

.result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}

.result-title {
    color: var(--text-primary);
    margin: 0;
    font-size: 1.1em;
    font-weight: 700;
}

.btn-close {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #ef4444;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1.2em;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.btn-close:hover {
    background: rgba(239, 68, 68, 0.3);
    border-color: #ef4444;
    transform: scale(1.1);
}

.result-wrapper {
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 16px;
    backdrop-filter: blur(10px);
}

.result-output {
    background: transparent;
    color: var(--accent-cyan);
    padding: 0;
    border: none;
    overflow-x: auto;
    max-height: 400px;
    font-family: 'Courier New', monospace;
    font-size: 0.95em;
    line-height: 1.8;
    margin: 0;
    white-space: pre-wrap;
    word-wrap: break-word;
}

/* Copilot Response Capture Panel */
.response-capture-panel {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(0, 217, 255, 0.1));
    border: 2px solid var(--accent-purple);
    border-radius: 16px;
    padding: 20px;
    margin-top: 20px;
    backdrop-filter: blur(20px);
    box-shadow: 0 0 30px rgba(139, 92, 246, 0.3);
    animation: fadeIn 0.4s ease-out;
}

.capture-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
}

.capture-title {
    color: var(--accent-purple);
    margin: 0;
    font-size: 1.2em;
    font-weight: 700;
    text-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
}

.capture-hint {
    color: var(--text-secondary);
    font-size: 0.9em;
    opacity: 0.8;
}

.capture-textarea {
    width: 100%;
    min-height: 150px;
    background: rgba(15, 23, 42, 0.9);
    border: 2px solid rgba(139, 92, 246, 0.4);
    border-radius: 12px;
    padding: 16px;
    color: var(--text-primary);
    font-family: 'Courier New', monospace;
    font-size: 0.95em;
    line-height: 1.6;
    resize: vertical;
    transition: all 0.3s ease;
}

.capture-textarea:focus {
    outline: none;
    border-color: var(--accent-purple);
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.4);
}

.capture-textarea::placeholder {
    color: rgba(148, 163, 184, 0.5);
}

.capture-actions {
    display: flex;
    gap: 12px;
    margin-top: 16px;
    justify-content: flex-end;
}

.btn-copilot {
    background: linear-gradient(135deg, var(--accent-purple), #8b5cf6);
    border: none;
    color: white;
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 1em;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(139, 92, 246, 0.4);
}

.btn-copilot:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(139, 92, 246, 0.6);
}

.btn-copilot:active {
    transform: translateY(0);
}


@media (max-width: 768px) {
    /* Auth & Layout */
    .auth-box {
        padding: 40px 24px;
        margin: 20px 16px;
        border-radius: 14px;
    }

    .auth-box h1 {
        font-size: 2.4em;
        margin-bottom: 8px;
    }

    /* Main Layout */
    .main-content {
        flex-direction: column;
        gap: 0;
    }

    .sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 2px solid var(--border-color);
        padding: 12px 16px;
        max-height: auto;
        background: rgba(10, 0, 20, 0.8);
    }

    .nav-menu {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 6px;
        justify-content: space-around;
    }

    .nav-item {
        flex: 1;
        min-width: 60px;
        min-height: 50px;
        padding: 10px 8px;
        font-size: 0.85em;
        justify-content: center;
    }

    .nav-label {
        display: inline;
        font-size: 0.7em;
        margin-left: 4px;
    }

    .nav-icon {
        font-size: 1.6em;
    }

    /* Header */
    .header {
        padding: 12px 16px;
    }

    .header-content {
        flex-direction: column;
        gap: 12px;
        padding: 12px 0;
    }

    .header-left {
        width: 100%;
        text-align: center;
    }

    .header-center {
        width: 100%;
        flex-direction: row;
        justify-content: center;
        gap: 12px;
    }

    .header-right {
        width: 100%;
        flex-direction: row;
        justify-content: space-between;
        gap: 10px;
        padding-top: 8px;
        border-top: 1px solid var(--border-color);
    }

    .header-title {
        font-size: 1.6em;
        margin: 0;
    }

    .status-indicator {
        font-size: 0.9em;
        padding: 6px 10px;
    }

    .ngrok-indicator {
        font-size: 0.85em;
    }

    .user-info {
        flex-direction: column;
        gap: 4px;
    }

    .user-details {
        display: block;
        text-align: center;
    }

    .user-name {
        display: block;
        font-size: 0.95em;
        margin-bottom: 2px;
    }

    .badge {
        font-size: 0.75em;
        padding: 3px 8px;
    }

    .btn-logout {
        width: 100%;
        min-height: 44px;
        padding: 10px 16px;
        font-size: 0.9em;
    }

    /* Content Area */
    .content {
        padding: 16px;
        flex: 1;
    }

    .view-title {
        font-size: 1.8em;
        margin-bottom: 20px;
        padding: 12px 8px;
    }

    /* Cards & Grids */
    .dashboard-grid,
    .admin-container,
    .bug-tracker-container,
    .settings-container {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .card {
        padding: 18px 16px;
        border-radius: 12px;
        margin-bottom: 8px;
    }

    .card-header {
        margin-bottom: 14px;
    }

    .card-header h3 {
        font-size: 1.2em;
    }

    /* Quick Actions */
    .quick-actions {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .action-btn {
        padding: 16px 12px;
        min-height: 52px;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 0.85em;
        gap: 6px;
    }

    .action-btn span {
        line-height: 1;
    }

    .action-icon {
        font-size: 1.8em;
        line-height: 1;
    }

    .action-label {
        display: block;
        text-align: center;
        font-size: 0.75em;
        font-weight: 500;
    }

    /* Form Elements */
    .form-group {
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        font-size: 0.95em;
        margin-bottom: 6px;
        font-weight: 500;
    }

    input[type="text"],
    input[type="email"],
    input[type="password"],
    textarea,
    select {
        width: 100%;
        padding: 12px 14px;
        font-size: 16px;
        min-height: 44px;
        border-radius: 8px;
    }

    textarea {
        min-height: 100px;
        resize: vertical;
    }

    /* Buttons */
    .btn-primary,
    .btn-secondary,
    .btn-danger,
    .btn-copilot {
        min-height: 44px;
        padding: 12px 18px;
        font-size: 0.95em;
        border-radius: 8px;
        width: 100%;
        cursor: pointer;
    }

    .btn-primary {
        margin-bottom: 8px;
    }

    /* Tools Grid */
    .tools-grid {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .tool-item {
        padding: 14px;
        min-height: 50px;
    }

    /* Modals */
    .modal {
        padding: 12px;
        z-index: 1000;
    }

    .modal-content {
        width: 95%;
        max-width: 100%;
        max-height: 95vh;
        padding: 20px 16px;
        border-radius: 12px;
        overflow-y: auto;
    }

    .close {
        top: 12px;
        right: 12px;
        font-size: 1.6em;
        width: 36px;
        height: 36px;
    }

    .modal-title {
        font-size: 1.4em;
        margin-bottom: 16px;
    }

    .modal-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 16px;
    }

    .modal-actions button {
        width: 100%;
        min-height: 44px;
    }

    /* Tool Inputs */
    .tool-inputs {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .tool-inputs .form-group {
        margin-bottom: 0;
    }

    /* Result Output */
    .tool-result {
        margin-top: 16px;
        max-height: 60vh;
        overflow: auto;
    }

    .result-output {
        font-size: 0.8em;
        padding: 12px;
        max-height: 50vh;
        overflow-y: auto;
    }

    /* File Browser */
    .file-browser {
        padding: 0;
    }

    .file-path-section {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 16px 0;
    }

    .file-input {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        min-height: 44px;
    }

    .btn-browse {
        width: 100%;
        min-height: 44px;
        padding: 12px;
    }

    .files-list {
        padding: 12px 0;
    }

    .file-item,
    .folder-item {
        padding: 14px 12px;
        min-height: 48px;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    /* Settings */
    .workspace-path-input,
    .github-token-input {
        font-size: 16px;
        width: 100%;
        padding: 12px;
        min-height: 44px;
    }

    .btn-secondary {
        padding: 10px 12px;
        font-size: 0.85em;
        min-height: 40px;
    }

    /* Remote Access */
    .url-box {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .url-input {
        padding: 12px;
        font-size: 14px;
        width: 100%;
        word-break: break-all;
    }

    .btn-copy {
        width: 100%;
        min-height: 44px;
        padding: 10px;
    }

    /* Activity & Logs */
    .activity-log-list,
    .execution-logs-list,
    .requests-list,
    .users-list,
    .permissions-list,
    .bugs-list {
        grid-template-columns: 1fr;
    }

    .activity-item,
    .log-entry,
    .request-item,
    .user-item,
    .permission-item,
    .bug-item {
        padding: 14px;
        margin-bottom: 10px;
    }

    /* Tabs */
    .tabs {
        flex-direction: column;
    }

    .tab-btn {
        width: 100%;
        padding: 14px 12px;
        justify-content: flex-start;
        min-height: 44px;
        font-size: 0.95em;
    }

    .tab-btn .tab-icon {
        margin-right: 8px;
        font-size: 1.2em;
    }

    .tab-content {
        padding: 16px 0;
    }

    /* Permissions Display */
    .permissions-list {
        flex-direction: column;
        gap: 8px;
    }

    /* Conversation Items */
    .conversation-item {
        padding: 14px;
        margin-bottom: 10px;
    }

    .conversation-item .question {
        font-size: 0.95em;
        margin-bottom: 8px;
    }

    .conversation-item .response {
        font-size: 0.85em;
    }

    /* Text Utilities */
    .info-text,
    .error-text,
    .success-text {
        font-size: 0.9em;
        margin: 10px 0;
    }

    /* Workspace Status */
    #workspace-status {
        font-size: 0.9em;
        margin-bottom: 10px;
    }

    /* Skeleton Loading */
    .skeleton {
        height: 48px;
        margin-bottom: 10px;
    }
}

@media (max-width: 480px) {
    html {
        font-size: 14px;
    }

    /* Auth */
    .auth-box {
        padding: 30px 18px;
        margin: 16px 12px;
    }

    .auth-box h1 {
        font-size: 2em;
    }

    .subtitle {
        font-size: 0.95em;
    }

    /* Header */
    .header {
        padding: 10px 12px;
    }

    .header-content {
        gap: 10px;
        padding: 10px 0;
    }

    .header-title {
        font-size: 1.4em;
    }

    .status-indicator,
    .ngrok-indicator {
        font-size: 0.8em;
        padding: 4px 8px;
    }

    .user-name {
        font-size: 0.85em;
    }

    /* Sidebar/Nav */
    .sidebar {
        padding: 10px 12px;
    }

    .nav-item {
        min-height: 48px;
        padding: 8px 6px;
        font-size: 0.75em;
    }

    .nav-icon {
        font-size: 1.4em;
    }

    .nav-label {
        font-size: 0.65em;
    }

    /* Content */
    .content {
        padding: 12px;
    }

    .view-title {
        font-size: 1.5em;
        margin-bottom: 16px;
        padding: 10px 0;
    }

    /* Cards */
    .card {
        padding: 14px 12px;
        margin-bottom: 6px;
    }

    .card-header h3 {
        font-size: 1.1em;
    }

    /* Quick Actions */
    .quick-actions {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .action-btn {
        padding: 12px 10px;
        min-height: 48px;
        border-radius: 8px;
    }

    .action-icon {
        font-size: 1.4em;
    }

    .action-label {
        font-size: 0.7em;
    }

    /* Forms */
    .form-group {
        margin-bottom: 14px;
    }

    .form-group label {
        font-size: 0.9em;
        margin-bottom: 4px;
    }

    input[type="text"],
    input[type="email"],
    input[type="password"],
    textarea,
    select {
        padding: 10px 12px;
        font-size: 16px;
        min-height: 42px;
    }

    textarea {
        min-height: 90px;
    }

    /* Buttons */
    .btn-primary,
    .btn-secondary,
    .btn-danger,
    .btn-copilot {
        padding: 10px 16px;
        font-size: 0.9em;
        min-height: 42px;
    }

    /* Modals */
    .modal-content {
        width: 98%;
        padding: 16px 12px;
    }

    .modal-title {
        font-size: 1.2em;
    }

    .close {
        width: 32px;
        height: 32px;
        font-size: 1.4em;
    }

    .tool-result {
        max-height: 55vh;
    }

    .result-output {
        font-size: 0.75em;
        padding: 10px;
    }

    /* File Browser */
    .file-path-section {
        gap: 8px;
    }

    .file-input {
        padding: 10px;
        min-height: 42px;
    }

    .btn-browse {
        min-height: 42px;
    }

    .file-item,
    .folder-item {
        padding: 12px 10px;
        min-height: 44px;
    }

    /* Settings */
    .workspace-path-input,
    .github-token-input {
        font-size: 16px;
        padding: 10px;
        min-height: 42px;
    }

    .btn-secondary {
        min-height: 38px;
        padding: 8px 10px;
        font-size: 0.8em;
    }

    /* Modal Actions */
    .modal-actions {
        gap: 8px;
    }

    .modal-actions button {
        min-height: 40px;
    }

    /* Tabs */
    .tab-btn {
        padding: 12px 10px;
        min-height: 42px;
        font-size: 0.9em;
    }

    /* Lists */
    .activity-item,
    .log-entry,
    .request-item,
    .user-item,
    .bug-item,
    .conversation-item {
        padding: 12px 10px;
    }

    .conversation-item .question {
        font-size: 0.9em;
    }

    .conversation-item .response {
        font-size: 0.8em;
    }

    /* QR */
    .qr-display-box {
        padding: 16px 12px;
    }

    .qr-code-img {
        max-width: 100%;
        height: auto;
    }

    .qr-instruction {
        font-size: 0.9em;
    }

    .qr-request-id {
        font-size: 0.8em;
    }

    /* Confirm Dialog */
    .confirm-content {
        padding: 18px 14px;
    }

    #confirm-title {
        font-size: 1.2em;
    }

    #confirm-message {
        font-size: 0.9em;
    }

    .confirm-actions {
        gap: 8px;
    }

    .confirm-actions button {
        min-height: 40px;
    }

    /* Loading Overlay */
    .loading-overlay {
        z-index: 2000;
    }

    .spinner {
        width: 40px;
        height: 40px;
    }

    #loading-text {
        font-size: 0.9em;
    }

    /* Toast */
    .toast-container {
        top: 10px;
        right: 10px;
        left: 10px;
        gap: 6px;
    }

    .toast {
        font-size: 0.85em;
        padding: 10px 12px;
    }
}

    .toast {
        min-width: 90vw;
        right: 5vw;
        left: auto;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .tabs {
        flex-direction: column;
    }

    .tab-btn {
        padding: 12px;
    }
}

/* ==================== BUG TRACKER ==================== */

.bug-tracker-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.bug-controls {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.bug-form {
    background: rgba(26, 40, 71, 0.7);
    border: 2px solid var(--accent-purple);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: fadeIn 0.3s ease-out;
}

.bug-input {
    width: 100%;
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(139, 92, 246, 0.4);
    border-radius: 8px;
    padding: 12px;
    color: var(--text-primary);
    font-family: 'Courier New', monospace;
    font-size: 0.95em;
}

.bug-input:focus {
    outline: none;
    border-color: var(--accent-purple);
    box-shadow: 0 0 10px rgba(139, 92, 246, 0.3);
}

.bug-form-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
}

.bugs-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.bug-item {
    background: rgba(26, 40, 71, 0.5);
    border: 1px solid rgba(100, 116, 139, 0.3);
    border-radius: 12px;
    padding: 16px;
    transition: all 0.3s ease;
}

.bug-item:hover {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.15);
}

.bug-item.bug-fixed {
    border-left: 4px solid #10b981;
    opacity: 0.8;
}

.bug-item.bug-open,
.bug-item.bug-reopened {
    border-left: 4px solid #ef4444;
}

.bug-item.bug-in_progress {
    border-left: 4px solid #f59e0b;
}

.bug-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
}

.bug-id {
    background: rgba(0, 255, 255, 0.15);
    color: var(--accent-cyan);
    padding: 2px 10px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.85em;
    font-family: 'Courier New', monospace;
}

.bug-status {
    font-size: 0.85em;
    font-weight: 600;
    color: var(--text-secondary);
}

.bug-severity {
    font-size: 0.75em;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid;
    letter-spacing: 0.5px;
}

.bug-body {
    margin-bottom: 12px;
}

.bug-title {
    color: var(--text-primary);
    margin: 0 0 6px 0;
    font-size: 1.05em;
}

.bug-desc {
    color: var(--text-secondary);
    font-size: 0.9em;
    margin: 0 0 8px 0;
    line-height: 1.5;
}

.bug-fix,
.bug-cause {
    font-size: 0.85em;
    color: rgba(148, 163, 184, 0.8);
    margin: 4px 0;
    padding-left: 10px;
    border-left: 2px solid rgba(100, 116, 139, 0.3);
}

.bug-footer {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 0.8em;
    color: var(--text-secondary);
}

.btn-reopen {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: #ef4444;
    padding: 4px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.95em;
    transition: all 0.3s ease;
}

.btn-reopen:hover {
    background: rgba(239, 68, 68, 0.35);
    border-color: #ef4444;
}

/* ==================== SELF-HEALING AI DOCTOR STYLES ==================== */

.self-healing-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.healing-section {
    background: linear-gradient(135deg, rgba(10, 0, 20, 0.8) 0%, rgba(26, 0, 51, 0.9) 100%);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 8px 32px rgba(0, 255, 255, 0.1);
    transition: all 0.3s ease;
}

.healing-section:hover {
    border-color: rgba(0, 255, 255, 0.5);
    box-shadow: 0 8px 32px rgba(0, 255, 255, 0.2);
}

.section-title {
    color: var(--accent-cyan);
    font-size: 1.3em;
    font-weight: 700;
    margin-bottom: 12px;
    text-shadow: 0 0 10px rgba(0, 255, 255, 0.4);
}

.section-subtitle {
    color: var(--text-muted);
    font-size: 0.95em;
    margin-bottom: 16px;
    font-style: italic;
}

.form-group {
    margin-bottom: 16px;
}

.form-group label {
    display: block;
    color: var(--text-primary);
    font-weight: 600;
    margin-bottom: 6px;
    font-size: 0.95em;
}

.form-input,
.form-input textarea {
    width: 100%;
    padding: 10px 12px;
    background: rgba(15, 0, 32, 0.8);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    color: var(--text-primary);
    font-size: 0.95em;
    font-family: inherit;
    transition: all 0.3s ease;
}

.form-input:focus,
.form-input textarea:focus {
    outline: none;
    border-color: var(--accent-cyan);
    background: rgba(15, 0, 32, 1);
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.radio-group {
    display: flex;
    gap: 20px;
    padding: 10px 0;
}

.radio-group label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-weight: 400;
    cursor: pointer;
}

.radio-group input[type="radio"] {
    cursor: pointer;
    accent-color: var(--accent-cyan);
}

.btn-large {
    width: 100%;
    padding: 14px 20px;
    font-size: 1.05em;
    font-weight: 700;
}

.update-controls {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
}

.btn-small {
    padding: 6px 12px;
    font-size: 0.85em;
    background: rgba(0, 255, 255, 0.15);
    border: 1px solid var(--border-color);
    color: var(--accent-cyan);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-small:hover {
    background: rgba(0, 255, 255, 0.3);
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
}

.issue-updates {
    background: rgba(15, 0, 32, 0.5);
    border-radius: 8px;
    padding: 12px;
    max-height: 400px;
    overflow-y: auto;
    border: 1px solid rgba(0, 255, 255, 0.2);
}

.update-item {
    background: rgba(26, 0, 51, 0.7);
    border-left: 4px solid var(--accent-cyan);
    padding: 12px;
    margin-bottom: 12px;
    border-radius: 6px;
    animation: slideInLeft 0.4s ease;
}

.update-item:last-child {
    margin-bottom: 0;
}

.update-item.placeholder {
    border-left-color: var(--text-muted);
    color: var(--text-muted);
    text-align: center;
}

.update-item.update-reported {
    border-left-color: var(--warning);
}

.update-item.update-in_progress {
    border-left-color: var(--text-primary);
    background: rgba(0, 255, 255, 0.05);
}

.update-item.update-fix_found {
    border-left-color: var(--success);
    background: rgba(0, 255, 0, 0.05);
}

.update-item.update-deploying {
    border-left-color: var(--accent-purple);
    background: rgba(255, 0, 255, 0.05);
}

.update-item.update-completed {
    border-left-color: var(--success);
    background: rgba(0, 255, 0, 0.08);
}

.update-item.update-error {
    border-left-color: var(--error);
    background: rgba(255, 0, 102, 0.05);
}

.update-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.update-time {
    color: var(--text-muted);
    font-size: 0.8em;
}

.update-badge {
    background: rgba(0, 255, 255, 0.2);
    color: var(--accent-cyan);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.85em;
    font-weight: 600;
}

.update-message {
    color: var(--text-secondary);
    font-size: 0.95em;
    margin-bottom: 8px;
    line-height: 1.4;
}

.update-url {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 8px;
    background: rgba(0, 255, 255, 0.1);
    border-radius: 4px;
    margin-top: 8px;
}

.url-link {
    color: var(--accent-cyan);
    text-decoration: none;
    font-family: monospace;
    font-size: 0.85em;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.url-link:hover {
    text-decoration: underline;
}

.issues-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
}

.issue-card {
    background: linear-gradient(135deg, rgba(15, 0, 32, 0.9) 0%, rgba(26, 0, 51, 0.8) 100%);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 14px;
    transition: all 0.3s ease;
    animation: fadeIn 0.5s ease;
}

.issue-card:hover {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.2);
}

.issue-card.issue-status-reported {
    border-left: 4px solid var(--warning);
}

.issue-card.issue-status-in-progress {
    border-left: 4px solid var(--text-primary);
}

.issue-card.issue-status-fixing {
    border-left: 4px solid var(--accent-purple);
}

.issue-card.issue-status-testing {
    border-left: 4px solid var(--text-muted);
}

.issue-card.issue-status-completed {
    border-left: 4px solid var(--success);
}

.issue-card.issue-status-deployed {
    border-left: 4px solid var(--accent-cyan);
}

.issue-card.issue-status-failed {
    border-left: 4px solid var(--error);
}

.issue-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10px;
    gap: 12px;
}

.issue-title {
    color: var(--text-primary);
    font-size: 1.05em;
    font-weight: 700;
    flex: 1;
}

.issue-badge {
    background: rgba(0, 255, 255, 0.2);
    color: var(--accent-cyan);
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 0.8em;
    font-weight: 600;
    white-space: nowrap;
}

.issue-priority {
    font-size: 0.85em;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 4px;
    margin-bottom: 8px;
    display: inline-block;
}

.priority-low {
    background: rgba(100, 200, 255, 0.2);
    color: #64c8ff;
    border: 1px solid rgba(100, 200, 255, 0.3);
}

.priority-medium {
    background: rgba(255, 200, 0, 0.2);
    color: #ffc800;
    border: 1px solid rgba(255, 200, 0, 0.3);
}

.priority-high {
    background: rgba(255, 100, 0, 0.2);
    color: #ff6400;
    border: 1px solid rgba(255, 100, 0, 0.3);
}

.priority-critical {
    background: rgba(255, 0, 100, 0.2);
    color: #ff0064;
    border: 1px solid rgba(255, 0, 100, 0.3);
}

.issue-details {
    color: var(--text-muted);
    font-size: 0.85em;
    margin-bottom: 8px;
    display: flex;
    gap: 16px;
}

.issue-details small {
    display: block;
}

.issue-url {
    background: rgba(0, 255, 255, 0.08);
    padding: 8px;
    border-radius: 4px;
    margin-bottom: 8px;
    border-left: 3px solid var(--accent-cyan);
}

.issue-url a {
    color: var(--accent-cyan);
    text-decoration: none;
    font-family: monospace;
    font-size: 0.9em;
    word-break: break-all;
}

.issue-url a:hover {
    text-decoration: underline;
}

.issue-files {
    color: var(--text-muted);
    font-size: 0.85em;
    background: rgba(100, 150, 255, 0.1);
    padding: 8px;
    border-radius: 4px;
    border-left: 3px solid rgba(100, 150, 255, 0.5);
}

.qr-container {
    background: rgba(26, 0, 51, 0.5);
    border: 2px dashed var(--border-color);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.qr-code {
    background: white;
    padding: 10px;
    border-radius: 8px;
    display: inline-block;
    margin-bottom: 16px;
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
}

.qr-image {
    max-width: 300px;
    height: auto;
    display: block;
}

.qr-text {
    color: var(--text-primary);
    font-weight: 600;
    margin-top: 12px;
}

.ngrok-url-text {
    color: var(--text-muted);
    font-size: 0.9em;
    margin-top: 12px;
}

.ngrok-url-text code {
    background: rgba(0, 255, 255, 0.1);
    color: var(--accent-cyan);
    padding: 4px 8px;
    border-radius: 4px;
    font-family: monospace;
    display: block;
    margin: 8px 0;
    word-break: break-all;
}

.view-subtitle {
    color: var(--text-muted);
    font-size: 0.95em;
    margin: 8px 0 20px 0;
}

.placeholder {
    color: var(--text-muted);
    text-align: center;
    padding: 24px;
    font-style: italic;
}

/* ========== Mobile Styles for Self-Healing ========== */

@media (max-width: 768px) {
    .form-row {
        grid-template-columns: 1fr;
    }
    
    .radio-group {
        flex-direction: column;
        gap: 12px;
    }
    
    .update-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
    }
    
    .update-url {
        flex-direction: column;
    }
    
    .issue-header {
        flex-direction: column;
    }
    
    .healing-section {
        padding: 16px;
    }
}

@media (max-width: 480px) {
    .healing-section {
        padding: 12px;
        margin: 0 -8px;
    }
    
    .qr-container {
        min-height: 250px;
        padding: 16px;
    }
    
    .form-input,
    .form-input textarea {
        font-size: 16px; /* Prevents zoom on iOS */
    }
    
    .btn-large {
        min-height: 44px;
    }
}
