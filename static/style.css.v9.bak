* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg-primary: #1e1e2e;
    --bg-secondary: #181825;
    --bg-surface: #252536;
    --bg-elevated: #2a2a3c;
    --bg-input: #1a1a2a;
    --accent: #7c3aed;
    --accent-hover: #6d28d9;
    --accent-subtle: rgba(124, 58, 237, 0.12);
    --accent-light: #a78bfa;
    --text-primary: #e2e8f0;
    --text-secondary: #94a3b8;
    --text-muted: #636e80;
    --border: #2e2e42;
    --border-hover: #3e3e56;
    --success: #22c55e;
    --error: #ef4444;
    --warning: #f59e0b;
    --info: #3b82f6;
    --radius: 8px;
    --radius-lg: 12px;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.3);
    --shadow-md: 0 4px 12px rgba(0,0,0,0.25);
    --shadow-lg: 0 8px 24px rgba(0,0,0,0.3);
    --transition: 0.2s ease;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes slideIn {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes slideInRight {
    from { opacity: 0; transform: translateX(8px); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes fadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes shimmer {
    0% { background-position: -600px 0; }
    100% { background-position: 600px 0; }
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: var(--bg-primary);
    min-height: 100vh;
    color: var(--text-primary);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    min-height: 100vh;
}

/* ==================== TOAST NOTIFICATIONS ==================== */

.toast-container {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 360px;
}

.toast {
    padding: 12px 16px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    animation: slideInRight 0.3s ease-out;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--bg-elevated);
    box-shadow: var(--shadow-md);
    font-size: 0.875rem;
}

.toast.success { border-left: 3px solid var(--success); color: var(--success); }
.toast.error { border-left: 3px solid var(--error); color: var(--error); }
.toast.warning { border-left: 3px solid var(--warning); color: var(--warning); }
.toast.info { border-left: 3px solid var(--info); color: var(--info); }

.toast-icon { font-size: 1.1em; }

/* ==================== LOADING OVERLAY ==================== */

.loading-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 2000;
}

.spinner {
    width: 36px;
    height: 36px;
    border: 3px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 16px;
}

#loading-text {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

/* ==================== AUTH VIEW ==================== */

.auth-view {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: fadeIn 0.4s ease-out;
}

.auth-box {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 40px;
    width: 100%;
    max-width: 420px;
}

.auth-header {
    text-align: center;
    margin-bottom: 32px;
}

.auth-box h1 {
    font-size: 1.75rem;
    color: var(--text-primary);
    font-weight: 700;
    margin-bottom: 6px;
    background: none;
    -webkit-background-clip: unset;
    -webkit-text-fill-color: unset;
    text-shadow: none;
    animation: none;
    letter-spacing: normal;
    text-transform: none;
}

.subtitle {
    color: var(--text-muted);
    font-size: 0.875rem;
}

.tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
}

.tab-btn {
    flex: 1;
    padding: 10px 12px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.85rem;
    transition: all var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.tab-btn::before { display: none; }
.tab-btn:hover { color: var(--text-primary); }

.tab-btn.active {
    color: var(--accent-light);
    border-bottom-color: var(--accent);
}

.tab-icon { font-size: 1em; }

.tab-content {
    display: none;
    animation: fadeIn 0.2s ease-out;
}

.tab-content.active { display: block; }

.form-group {
    margin-bottom: 16px;
}

.form-group label {
    display: block;
    margin-bottom: 6px;
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.85rem;
}

.auth-box input {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    background: var(--bg-input);
    border-radius: var(--radius);
    font-size: 0.9rem;
    color: var(--text-primary);
    transition: border-color var(--transition);
    font-family: inherit;
    box-shadow: none;
}

.auth-box input::placeholder { color: var(--text-muted); }

.auth-box input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-subtle);
}

.auth-box button {
    width: 100%;
    padding: 10px 16px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: var(--radius);
    font-weight: 600;
    cursor: pointer;
    transition: background var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.9rem;
    box-shadow: none;
}

.auth-box button::before { display: none; }
.auth-box button:hover { background: var(--accent-hover); transform: none; box-shadow: none; }
.auth-box button:active { transform: scale(0.98); }

.error-msg {
    color: var(--error);
    margin-top: 10px;
    font-size: 0.85rem;
    text-align: center;
}

.info-text {
    background: rgba(34, 197, 94, 0.08);
    color: var(--success);
    padding: 10px 12px;
    border-radius: var(--radius);
    margin-bottom: 14px;
    font-size: 0.8rem;
    border-left: 3px solid var(--success);
}

.qr-display-box {
    text-align: center;
    padding: 20px;
    background: var(--bg-elevated);
    border-radius: var(--radius-lg);
    margin-top: 16px;
    border: 1px solid var(--border);
}

.qr-image-wrapper { margin: 12px 0; }

.qr-code-img {
    max-width: 180px;
    width: 100%;
    padding: 8px;
    background: white;
    border-radius: var(--radius);
    animation: none;
}

.qr-instruction {
    color: var(--text-secondary);
    margin-top: 12px;
    font-size: 0.85rem;
}

.qr-request-id {
    margin-top: 8px;
    color: var(--accent-light);
    font-size: 0.8rem;
    word-break: break-all;
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
}

/* ==================== MAIN VIEW ==================== */

.main-view {
    display: flex;
    flex-direction: column;
    animation: fadeIn 0.3s ease-out;
}

.header {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 20px;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    gap: 16px;
}

.header-left { flex: 0 0 auto; }

.header-title {
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 700;
    background: none;
    -webkit-background-clip: unset;
    -webkit-text-fill-color: unset;
    letter-spacing: normal;
}

.header-center {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex: 1;
}

.status-indicator {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
    padding: 4px 10px;
    border-radius: var(--radius);
    background: var(--bg-surface);
    border: 1px solid var(--border);
}

.status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success);
    animation: none;
}

.status-indicator.active { color: var(--success); }

.ngrok-indicator {
    padding: 4px 10px;
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.8rem;
    font-weight: 500;
    animation: none;
}

.header-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
}

.user-info {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
}

.user-details {
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.user-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.85rem;
}

.badge {
    background: var(--accent);
    color: white;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 600;
    display: inline-block;
}

.badge.superuser { background: var(--warning); color: #000; }

.btn-logout {
    padding: 6px 12px;
    background: transparent;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    font-weight: 500;
    transition: all var(--transition);
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
}

.btn-logout:hover {
    color: var(--error);
    border-color: var(--error);
    background: rgba(239, 68, 68, 0.08);
    transform: none;
    box-shadow: none;
}

/* ==================== MAIN LAYOUT ==================== */

.main-content {
    display: flex;
    flex: 1;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
}

.sidebar {
    width: 200px;
    background: var(--bg-secondary);
    border-right: 1px solid var(--border);
    padding: 12px;
    overflow-y: auto;
    flex-shrink: 0;
}

.sidebar::-webkit-scrollbar { width: 4px; }
.sidebar::-webkit-scrollbar-track { background: transparent; }
.sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

.nav-menu {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.nav-item {
    padding: 8px 10px;
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
    font-weight: 500;
    transition: all var(--transition);
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    position: relative;
    overflow: visible;
}

.nav-item::before { display: none; }

.nav-item:hover {
    background: var(--bg-surface);
    color: var(--text-primary);
    transform: none;
}

.nav-item.active {
    background: var(--accent-subtle);
    color: var(--accent-light);
}

.nav-icon { font-size: 1.1em; }
.nav-label { display: inline-block; }

.content {
    flex: 1;
    padding: 24px;
    overflow-y: auto;
    min-height: calc(100vh - 52px);
}

.content::-webkit-scrollbar { width: 6px; }
.content::-webkit-scrollbar-track { background: transparent; }
.content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

.view {
    display: none;
    animation: fadeIn 0.25s ease-out;
}

.view.active { display: block; }

.view-title {
    color: var(--text-primary);
    margin-bottom: 20px;
    font-size: 1.5rem;
    font-weight: 700;
}

.skeleton {
    height: 48px;
    background: linear-gradient(90deg, var(--bg-surface) 25%, var(--bg-elevated) 50%, var(--bg-surface) 75%);
    background-size: 600px 100%;
    animation: shimmer 1.5s infinite;
    border-radius: var(--radius);
    margin-bottom: 8px;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
}

.card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px;
    transition: border-color var(--transition);
}

.card::before { display: none; }

.card:hover {
    border-color: var(--border-hover);
    transform: none;
    box-shadow: none;
}

.card-primary { border-top: 2px solid var(--accent); }
.card-permissions { border-top: 2px solid var(--success); }
.card-access { border-top: 2px solid var(--info); }
.card-admin { border-top: 2px solid var(--warning); }

.card-header { margin-bottom: 16px; }

.card h3 {
    color: var(--text-primary);
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
}

.action-btn {
    padding: 12px 10px;
    background: var(--bg-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    font-weight: 500;
    transition: all var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.8rem;
}

.action-btn::before { display: none; }

.action-btn:hover {
    background: var(--accent-subtle);
    border-color: var(--accent);
    color: var(--accent-light);
    transform: none;
    box-shadow: none;
}

.action-open, .action-run, .action-chat { border-color: var(--border); }

.action-icon { font-size: 1.2em; }
.action-label { display: inline-block; }

.permissions-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.permission-item {
    padding: 8px 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 8px;
    border-left: 3px solid transparent;
    transition: none;
}

.permission-item.granted {
    color: var(--success);
    background: rgba(34, 197, 94, 0.05);
    border-left-color: var(--success);
}

.permission-item.denied {
    color: var(--error);
    background: rgba(239, 68, 68, 0.05);
    border-left-color: var(--error);
}

.ngrok-box {
    padding: 16px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
}

.ngrok-label {
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 8px;
    display: block;
}

.url-box {
    display: flex;
    gap: 8px;
    margin: 8px 0;
}

.url-input {
    flex: 1;
    padding: 8px 10px;
    border: 1px solid var(--border);
    background: var(--bg-input);
    border-radius: 6px;
    font-size: 0.8rem;
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    color: var(--accent-light);
    word-break: break-all;
}

.btn-copy {
    padding: 8px 12px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: background var(--transition);
    display: flex;
    align-items: center;
}

.btn-copy:hover { background: var(--accent-hover); transform: none; box-shadow: none; }

.ngrok-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 8px 0 0 0;
}

.placeholder {
    text-align: center;
    color: var(--text-muted);
    padding: 32px 16px;
    font-size: 0.9rem;
    font-style: normal;
}

.tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
}

.tool-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    cursor: pointer;
    transition: all var(--transition);
}

.tool-card::before { display: none; }

.tool-card:hover {
    border-color: var(--accent);
    background: var(--bg-elevated);
    transform: none;
    box-shadow: none;
}

.tool-card h3 {
    color: var(--accent-light);
    margin-bottom: 6px;
    font-size: 0.95rem;
    font-weight: 600;
}

.tool-card p {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-bottom: 10px;
    line-height: 1.4;
}

.tool-permission {
    display: inline-block;
    padding: 3px 8px;
    background: var(--accent-subtle);
    color: var(--accent-light);
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
    border: 1px solid var(--border);
}

.tool-permission.denied {
    background: rgba(239, 68, 68, 0.08);
    color: var(--error);
    border-color: rgba(239, 68, 68, 0.2);
}

.file-browser {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px;
}

.file-path-section {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}

.file-input {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid var(--border);
    background: var(--bg-input);
    border-radius: var(--radius);
    font-size: 0.9rem;
    color: var(--text-primary);
    transition: border-color var(--transition);
}

.file-input::placeholder { color: var(--text-muted); }

.file-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-subtle);
}

.btn-browse {
    padding: 8px 16px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    font-weight: 600;
    transition: background var(--transition);
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
}

.btn-browse:hover { background: var(--accent-hover); transform: none; box-shadow: none; }

.files-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.file-item {
    padding: 10px 12px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
    transition: all var(--transition);
    display: flex;
    align-items: center;
    gap: 10px;
    border-left: 3px solid transparent;
}

.file-item:hover {
    background: var(--accent-subtle);
    border-left-color: var(--accent);
    transform: none;
    box-shadow: none;
}

.file-icon { font-size: 1.2em; min-width: 24px; }

/* ==================== ACTIVITY LOG ==================== */

.activity-container {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px;
}

.activity-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}

.activity-log-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 70vh;
    overflow-y: auto;
}

.activity-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px;
    transition: all var(--transition);
    border-left: 3px solid var(--accent);
    cursor: pointer;
}

.activity-item.error { border-left-color: var(--error); }

.activity-item:hover {
    background: var(--bg-input);
    border-color: var(--border-hover);
}

.activity-item.expanded {
    background: var(--bg-input);
    border-color: var(--accent);
}

.activity-header {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
}

.activity-status { font-size: 1em; min-width: 20px; }

.activity-tool {
    font-weight: 600;
    color: var(--accent-light);
    min-width: 100px;
}

.activity-time {
    color: var(--text-muted);
    margin-left: auto;
    font-size: 0.8rem;
}

.activity-expand {
    color: var(--text-muted);
    font-size: 0.7rem;
    margin-left: 8px;
    transition: transform var(--transition);
}

.activity-body {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.activity-action {
    color: var(--text-primary);
    font-size: 0.85rem;
    margin: 0;
}

.activity-result {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin: 0;
    word-break: break-word;
    max-height: 200px;
    overflow-y: auto;
    background: var(--bg-secondary);
    padding: 8px;
    border-radius: 4px;
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    white-space: pre-wrap;
}

.activity-device {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin: 0;
}

.btn-copy-sm {
    padding: 4px 10px;
    background: var(--bg-surface);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.75rem;
    transition: all var(--transition);
    align-self: flex-start;
}

.btn-copy-sm:hover {
    background: var(--accent-subtle);
    color: var(--accent-light);
    border-color: var(--accent);
}

/* ==================== CONVERSATIONS ==================== */

.conversations-container {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px;
}

.conversations-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}

.conversations-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 70vh;
    overflow-y: auto;
}

.conversation-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    transition: all var(--transition);
    border-left: 3px solid var(--accent);
}

.conversation-item.error { border-left-color: var(--error); }

.conversation-item:hover {
    border-color: var(--border-hover);
    transform: none;
    box-shadow: none;
}

.conversation-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 0.85rem;
}

.conversation-status { font-size: 1em; min-width: 20px; }

.conversation-time {
    color: var(--text-muted);
    margin-left: auto;
    font-size: 0.8rem;
}

.conversation-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.conversation-query {
    padding: 10px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 6px;
}

.query-label {
    color: var(--accent-light);
    font-weight: 600;
    margin: 0 0 4px 0;
    font-size: 0.8rem;
}

.query-text {
    color: var(--text-primary);
    margin: 0;
    word-wrap: break-word;
    font-size: 0.875rem;
}

.conversation-response {
    padding: 10px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 6px;
}

.response-label {
    color: var(--success);
    font-weight: 600;
    margin: 0 0 4px 0;
    font-size: 0.8rem;
}

.response-text {
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
    max-height: 200px;
    overflow-y: auto;
    font-size: 0.85rem;
}

/* ==================== EXECUTION LOGS ==================== */

.execution-logs-container {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 20px;
}

.execution-logs-controls {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
}

.execution-logs-list {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-secondary);
    max-height: 70vh;
    overflow-y: auto;
}

.logs-header {
    padding: 12px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elevated);
}

.logs-info {
    color: var(--accent-light);
    font-weight: 600;
    margin: 0 0 4px 0;
    font-size: 0.85rem;
}

.logs-path {
    color: var(--text-muted);
    font-size: 0.8rem;
    margin: 0;
    word-break: break-all;
}

.logs-content {
    padding: 12px;
    overflow-x: auto;
}

.logs-text {
    margin: 0;
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text-secondary);
    white-space: pre-wrap;
    word-wrap: break-word;
}

/* ==================== ADMIN ==================== */

.admin-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
}

.requests-list, .users-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.request-item, .user-item {
    padding: 14px;
    background: var(--bg-elevated);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border);
    transition: all var(--transition);
    animation: none;
}

.request-item:hover, .user-item:hover {
    border-color: var(--border-hover);
    transform: none;
    box-shadow: none;
}

.request-item.pending { border-left-color: var(--warning); background: rgba(245, 158, 11, 0.04); }
.request-item.approved { border-left-color: var(--success); background: rgba(34, 197, 94, 0.04); }
.request-item.rejected { border-left-color: var(--error); background: rgba(239, 68, 68, 0.04); }

.request-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
}

/* ==================== BUTTONS ==================== */

.btn-approve, .btn-reject, .btn-secondary, .btn-primary, .btn-danger {
    padding: 8px 14px;
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    font-weight: 600;
    transition: all var(--transition);
    font-size: 0.85rem;
}

.btn-approve { background: var(--success); color: white; box-shadow: none; }
.btn-approve:hover { background: #16a34a; transform: none; box-shadow: none; }

.btn-reject, .btn-danger { background: var(--error); color: white; box-shadow: none; }
.btn-reject:hover, .btn-danger:hover { background: #dc2626; transform: none; box-shadow: none; }

.btn-secondary {
    background: var(--bg-elevated);
    color: var(--text-secondary);
    border: 1px solid var(--border);
}
.btn-secondary:hover {
    background: var(--bg-surface);
    border-color: var(--border-hover);
    color: var(--text-primary);
}

.btn-primary {
    background: var(--accent);
    color: white;
    text-transform: none;
    letter-spacing: normal;
    font-family: inherit;
    box-shadow: none;
}
.btn-primary:hover {
    background: var(--accent-hover);
    transform: none;
    box-shadow: none;
    animation: none;
}

.btn-copilot {
    background: var(--accent);
    border: none;
    color: white;
    padding: 8px 16px;
    border-radius: var(--radius);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background var(--transition);
    box-shadow: none;
}
.btn-copilot:hover { background: var(--accent-hover); transform: none; box-shadow: none; }

/* ==================== MODAL ==================== */

.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
}

.modal.open {
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-content {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 24px;
    border-radius: var(--radius-lg);
    max-width: 600px;
    width: 90%;
    box-shadow: var(--shadow-lg);
    max-height: 90vh;
    overflow-y: auto;
    animation: none;
}

.close {
    float: right;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--text-muted);
    background: none;
    border: none;
    transition: color var(--transition);
    line-height: 1;
}

.close:hover { color: var(--text-primary); }

.modal-title {
    color: var(--text-primary);
    margin-bottom: 16px;
    margin-top: 8px;
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: none;
    letter-spacing: normal;
    animation: none;
}

.tool-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.tool-inputs {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.tool-inputs label {
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 0.85rem;
    margin-bottom: 4px;
    display: block;
}

.tool-inputs input, .tool-inputs textarea {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--border);
    background: var(--bg-input);
    border-radius: var(--radius);
    font-size: 0.9rem;
    color: var(--text-primary);
    transition: border-color var(--transition);
    font-family: inherit;
}

.tool-inputs input::placeholder, .tool-inputs textarea::placeholder { color: var(--text-muted); }

.tool-inputs input:focus, .tool-inputs textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-subtle);
}

.tool-inputs textarea {
    resize: vertical;
    min-height: 100px;
}

.modal-actions {
    display: flex;
    gap: 8px;
    margin-top: 16px;
}

.tool-result {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-top: 16px;
    animation: none;
}

.result-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.result-title {
    color: var(--text-primary);
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
}

.btn-close {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: var(--error);
    width: 28px;
    height: 28px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition);
}

.btn-close:hover { background: rgba(239, 68, 68, 0.2); transform: none; }

.result-wrapper {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px;
}

.result-output {
    background: transparent;
    color: var(--text-secondary);
    padding: 0;
    border: none;
    overflow-x: auto;
    max-height: 400px;
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 0.8rem;
    line-height: 1.7;
    margin: 0;
    white-space: pre-wrap;
    word-wrap: break-word;
}

/* ==================== COPILOT RESPONSE CAPTURE ==================== */

.response-capture-panel {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-top: 16px;
}

.capture-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 12px;
}

.capture-title {
    color: var(--accent-light);
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    text-shadow: none;
}

.capture-hint {
    color: var(--text-muted);
    font-size: 0.8rem;
}

.capture-textarea {
    width: 100%;
    min-height: 120px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px;
    color: var(--text-primary);
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    resize: vertical;
    transition: border-color var(--transition);
}

.capture-textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-subtle);
}

.capture-textarea::placeholder { color: var(--text-muted); }

.capture-actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    justify-content: flex-end;
}

/* ==================== CONFIRM DIALOG ==================== */

.modal-confirm {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
}

.confirm-content {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    max-width: 400px;
    width: 90%;
    box-shadow: var(--shadow-lg);
}

#confirm-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 8px;
}

#confirm-message {
    color: var(--text-secondary);
    margin-bottom: 16px;
    font-size: 0.9rem;
}

.confirm-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

/* ==================== BUG TRACKER ==================== */

.bug-tracker-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.bug-controls {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.bug-form {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    animation: fadeIn 0.2s ease-out;
}

.bug-input {
    width: 100%;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 8px 12px;
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.9rem;
}

.bug-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-subtle);
}

.bug-form-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

.bugs-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.bug-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
    transition: all var(--transition);
}

.bug-item:hover { border-color: var(--border-hover); box-shadow: none; }

.bug-item.bug-fixed { border-left: 3px solid var(--success); opacity: 0.7; }
.bug-item.bug-open, .bug-item.bug-reopened { border-left: 3px solid var(--error); }
.bug-item.bug-in_progress { border-left: 3px solid var(--warning); }

.bug-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    flex-wrap: wrap;
}

.bug-id {
    background: var(--accent-subtle);
    color: var(--accent-light);
    padding: 2px 8px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.75rem;
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
}

.bug-status { font-size: 0.8rem; font-weight: 500; color: var(--text-secondary); }

.bug-severity {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid;
}

.bug-body { margin-bottom: 8px; }

.bug-title { color: var(--text-primary); margin: 0 0 4px 0; font-size: 0.95rem; }

.bug-desc { color: var(--text-muted); font-size: 0.85rem; margin: 0 0 6px 0; line-height: 1.4; }

.bug-fix, .bug-cause {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 4px 0;
    padding-left: 8px;
    border-left: 2px solid var(--border);
}

.bug-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 0.75rem;
    color: var(--text-muted);
}

.btn-reopen {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: var(--error);
    padding: 3px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.8rem;
    transition: all var(--transition);
}

.btn-reopen:hover { background: rgba(239, 68, 68, 0.2); }

/* ==================== RESPONSIVE - TABLET ==================== */

@media (max-width: 768px) {
    .auth-box {
        padding: 28px 20px;
        margin: 16px;
    }

    .main-content { flex-direction: column; }

    .sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 1px solid var(--border);
        padding: 8px 12px;
    }

    .nav-menu {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 4px;
    }

    .nav-item {
        flex: 0 0 auto;
        min-width: 56px;
        padding: 8px 6px;
        justify-content: center;
        flex-direction: column;
        text-align: center;
        gap: 2px;
    }

    .nav-label { font-size: 0.65rem; display: block; }
    .nav-icon { font-size: 1.2em; }

    .header-content {
        flex-direction: column;
        gap: 8px;
        padding: 8px 12px;
    }

    .header-left { width: 100%; text-align: center; }
    .header-center { width: 100%; justify-content: center; }
    .header-right { width: 100%; justify-content: space-between; }
    .header-title { font-size: 1rem; }

    .content { padding: 16px; min-height: auto; }
    .view-title { font-size: 1.25rem; }

    .dashboard-grid, .admin-container { grid-template-columns: 1fr; }
    .quick-actions { grid-template-columns: repeat(2, 1fr); }
    .tools-grid { grid-template-columns: 1fr; }

    .modal-content { width: 95%; max-height: 90vh; padding: 16px; }
    .file-path-section { flex-direction: column; }
    .url-box { flex-direction: column; }
    .form-row { grid-template-columns: 1fr; }
    .radio-group { flex-direction: column; gap: 8px; }

    .issue-header { flex-direction: column; }
    .update-header { flex-direction: column; align-items: flex-start; gap: 4px; }
    .update-url { flex-direction: column; }

    /* Touch-friendly sizing */
    input[type="text"],
    input[type="email"],
    input[type="password"],
    textarea,
    select {
        font-size: 16px;
        min-height: 44px;
        padding: 10px 12px;
    }

    .btn-primary, .btn-secondary, .btn-danger, .btn-copilot, .btn-logout, .action-btn {
        min-height: 44px;
    }

    .modal-actions { flex-direction: column; }
    .modal-actions button { width: 100%; }

    .tabs { flex-direction: column; gap: 2px; }
    .tab-btn { padding: 10px 12px; justify-content: flex-start; }

    .conversations-list, .activity-log-list { max-height: 60vh; }
    .activity-header { flex-wrap: wrap; }
    .activity-time { margin-left: 0; }

    .healing-section { padding: 16px; }
}

/* ==================== RESPONSIVE - PHONE ==================== */

@media (max-width: 480px) {
    html { font-size: 14px; }

    .auth-box { padding: 24px 16px; margin: 12px; }
    .auth-box h1 { font-size: 1.5rem; }

    .header-content { gap: 6px; padding: 6px 10px; }
    .header-title { font-size: 0.95rem; }
    .status-indicator, .ngrok-indicator { font-size: 0.75rem; padding: 3px 6px; }

    .sidebar { padding: 6px 8px; }
    .nav-item { min-width: 48px; padding: 6px 4px; }
    .nav-label { font-size: 0.6rem; }

    .content { padding: 12px; }
    .view-title { font-size: 1.1rem; margin-bottom: 14px; }

    .card { padding: 14px; }
    .quick-actions { gap: 6px; }

    .action-btn {
        padding: 10px 6px;
        font-size: 0.75rem;
        flex-direction: column;
        gap: 4px;
    }
    .action-icon { font-size: 1.3em; }
    .action-label { font-size: 0.65rem; }

    .btn-primary, .btn-secondary, .btn-danger, .btn-copilot { font-size: 0.85rem; }

    .modal-content { width: 98%; padding: 14px 10px; }
    .result-output { font-size: 0.7rem; }

    .toast-container { top: 8px; right: 8px; left: 8px; max-width: 100%; }
    .toast { min-width: auto; font-size: 0.8rem; }

    .healing-section { padding: 14px; }
    .qr-container { min-height: 200px; padding: 14px; }

    .form-input, .form-input textarea { font-size: 16px; }
    .btn-large { min-height: 44px; }

    .user-info { padding: 3px 6px; }
    .user-name { font-size: 0.75rem; }
    .badge { font-size: 0.6rem; padding: 1px 6px; }
    .btn-logout { padding: 4px 8px; font-size: 0.75rem; }
}
