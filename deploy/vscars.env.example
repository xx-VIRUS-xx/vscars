# VSCARS production env — Cloudflare Tunnel deployment
# Copy to /etc/vscars/vscars.env on EC2
# chmod 600 /etc/vscars/vscars.env
# Never commit real values to git.

# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////var/lib/vscars/vscars.db

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-hex-chars

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# uvicorn binds to 127.0.0.1 — Cloudflare Tunnel connects to it
HOST=127.0.0.1
PORT=8000

APP_BASE_URL=https://vscars.latenightstack.com

# With Cloudflare Tunnel, your real origin is the tunnel domain
# Wildcard (*) is fine during beta; lock down once you have a user base
ALLOWED_ORIGINS=https://vscars.latenightstack.com

# FORCE_HTTPS=true adds HSTS headers — safe because Cloudflare handles TLS
FORCE_HTTPS=true

# ── Email (Resend — free tier: 100 emails/day) ────────────────────────────────
RESEND_API_KEY=re_xxxx
FROM_EMAIL=VSCARS <noreply@latenightstack.com>

# ── AI providers ──────────────────────────────────────────────────────────────
# Users configure their own keys via Settings in the app.
# These are server-side fallbacks only — safe to leave blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

# ── Billing (leave blank during beta) ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_SELF_HOSTED_MONTHLY=
STRIPE_PRICE_SELF_HOSTED_LIFETIME=
