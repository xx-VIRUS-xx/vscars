# Copy to /etc/vscars/vscars.env on your server
# Never commit real secrets.

DATABASE_URL=sqlite:////var/lib/vscars/vs_code_controller.db
SECRET_KEY=replace-with-strong-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

HOST=0.0.0.0
PORT=8000
APP_BASE_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com
FORCE_HTTPS=true

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_SELF_HOSTED_MONTHLY=
STRIPE_PRICE_SELF_HOSTED_LIFETIME=

# Email
RESEND_API_KEY=
FROM_EMAIL=VSCARS <noreply@yourdomain.com>

# Optional AI providers
GITHUB_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
